# Copie este arquivo para .env e preencha com os valores do seu projeto Firebase.
# Para obter esses valores:
#   1. Acesse https://console.firebase.google.com
#   2. Crie um projeto (ou abra um existente)
#   3. Vá em "Configurações do projeto" > "Seus apps" > adicione um app Web
#   4. Copie o objeto firebaseConfig

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Habilita o emulador local do Firebase (Firestore + Auth).
# Deixe como 'false' em produção.
VITE_FIREBASE_USE_EMULATOR=false
