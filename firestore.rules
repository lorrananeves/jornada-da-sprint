rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Sessões de retrospectiva ──────────────────────────────────────────────
    match /sessions/{sessionId} {

      // sessionId deve ser hex de 32 chars (gerado com crypto.getRandomValues)
      allow read: if sessionId.matches('^[0-9a-f]{32}$');

      allow create: if
        sessionId.matches('^[0-9a-f]{32}$')
        && isValidSessionRoot(request.resource.data);

      allow update: if
        sessionId.matches('^[0-9a-f]{32}$')
        && isValidSessionRoot(request.resource.data)
        && (
          !isChangingPhaseFields(request.resource.data, resource.data)
          || isScrumMaster(request.resource.data, resource.data)
        );

      // ── Checkins ─────────────────────────────────────────────────────────
      match /checkins/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isValidCheckin(request.resource.data);
        // Checkins são imutáveis após criação
        allow update, delete: if false;
      }

      // ── Tesouros ─────────────────────────────────────────────────────────
      match /treasures/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isValidTreasure(request.resource.data);
        // Só permite atualizar reações (campos reactions.*)
        allow update: if
          validSessionId(sessionId)
          && isReactionUpdate(request.resource.data, resource.data, ['text', 'category', 'id']);
        allow delete: if false;
      }

      // ── Monstros ─────────────────────────────────────────────────────────
      match /monsters/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isValidMonster(request.resource.data);
        // Permite atualizar reações e flag selected
        allow update: if
          validSessionId(sessionId)
          && isMonsterUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }

      // ── Soluções ─────────────────────────────────────────────────────────
      match /solutions/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isValidSolution(request.resource.data);
        // Só permite incrementar votos
        allow update: if
          validSessionId(sessionId)
          && isVoteUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }

      // ── Missões ──────────────────────────────────────────────────────────
      match /missions/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isValidMission(request.resource.data);
        allow update: if false;
        // Remoção permitida (o SM pode remover missões)
        allow delete: if validSessionId(sessionId);
      }

      // ── Presença (lobby) ─────────────────────────────────────────────────
      match /presence/{deviceId} {
        allow read: if true;
        // delete: permitido (leaveSession melhor esforço)
        allow delete: if deviceId.matches('^[0-9a-f]{16}$');
        // create/update: heartbeat — valida schema com lastSeen + expiresAt
        allow create, update: if
          deviceId.matches('^[0-9a-f]{16}$')
          && request.resource.data.keys().hasOnly(['deviceId', 'lastSeen', 'expiresAt'])
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() == 16
          && request.resource.data.expiresAt is number
          && request.resource.data.expiresAt > request.time.toMillis();
      }
    }

    // Bloqueia qualquer outra coleção não prevista
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── Funções auxiliares ────────────────────────────────────────────────────────

function validSessionId(sessionId) {
  return sessionId.matches('^[0-9a-f]{32}$');
}

function isValidSessionRoot(data) {
  return
    data.keys().hasAll(['currentPhase', 'updatedAt', 'smDeviceId'])
    && data.keys().hasOnly([
      'sprint', 'team', 'currentPhase', 'retroStarted',
      'xp', 'completedPhases', 'createdAt', 'updatedAt', 'smDeviceId',
      '_prefillMission'
    ])
    && data.currentPhase is string
    && data.currentPhase.size() <= 32
    && data.updatedAt is string
    && data.smDeviceId is string
    && data.smDeviceId.size() <= 32
    && data.get('xp', 0) is number
    && data.get('xp', 0) >= 0
    && data.get('retroStarted', false) is bool
    && data.get('completedPhases', []).size() <= 20
    && isValidSprint(data.get('sprint', {}))
    && isValidTeam(data.get('team', {}));
}

function isValidSprint(sprint) {
  return sprint is map
    && sprint.keys().hasOnly(['name', 'startDate', 'endDate'])
    && sprint.get('name', '') is string
    && sprint.get('name', '').size() <= 120
    && sprint.get('startDate', '') is string
    && sprint.get('endDate', '') is string;
}

function isValidTeam(team) {
  return team is map
    && team.keys().hasOnly(['name', 'participantCount'])
    && team.get('name', '') is string
    && team.get('name', '').size() <= 120;
}

function isChangingPhaseFields(newData, oldData) {
  return
    newData.get('currentPhase', null) != oldData.get('currentPhase', null)
    || newData.get('completedPhases', []) != oldData.get('completedPhases', []);
}

function isScrumMaster(newData, oldData) {
  return
    newData.smDeviceId == oldData.smDeviceId
    && newData.smDeviceId != null
    && newData.smDeviceId.size() > 0;
}

// ── Validadores de subcoleção ─────────────────────────────────────────────────

function isValidCheckin(data) {
  return data.keys().hasOnly(['score', 'comment'])
    && data.score is number
    && data.score >= 1 && data.score <= 5
    && (data.get('comment', null) == null
        || (data.comment is string && data.comment.size() <= 1000));
}

function isValidTreasure(data) {
  return data.keys().hasOnly(['text', 'category', 'reactions'])
    && data.text is string
    && data.text.size() >= 1 && data.text.size() <= 1000
    && data.category is string
    && data.category in ['treasure', 'recognition', 'learning']
    && data.reactions is map;
}

function isValidMonster(data) {
  return data.keys().hasOnly(['text', 'reactions', 'selected'])
    && data.text is string
    && data.text.size() >= 1 && data.text.size() <= 1000
    && data.reactions is map
    && data.selected is bool;
}

function isValidSolution(data) {
  return data.keys().hasOnly(['text', 'monsterId', 'strategy', 'votes'])
    && data.text is string
    && data.text.size() >= 1 && data.text.size() <= 1000
    && data.monsterId is string
    && data.strategy is string
    && data.strategy in ['prevent', 'reduce', 'handle']
    && data.votes is number;
}

function isValidMission(data) {
  return data.keys().hasOnly(['title', 'description', 'strategy', 'priority', 'owner', 'deadline'])
    && data.title is string
    && data.title.size() >= 1 && data.title.size() <= 200
    && data.get('description', '') is string
    && data.get('description', '').size() <= 2000
    && data.get('strategy', '') is string
    && data.get('owner', '') is string
    && data.get('owner', '').size() <= 120
    && data.get('deadline', '') is string
    && data.priority is string
    && data.priority in ['high', 'medium', 'low'];
}

// Reação: só o campo reactions.* pode mudar, o resto deve ser igual
function isReactionUpdate(newData, oldData, immutableFields) {
  return immutableFields.size() == 0
    || immutableFields.toSet().difference(
         newData.keys().toSet().intersection(immutableFields.toSet())
       ).size() == 0
    && immutableFields.toSet().hasAll(
         newData.keys().toSet().intersection(immutableFields.toSet())
       );
}

// Monstro: permite mudar reactions.* e selected, nada mais
function isMonsterUpdate(newData, oldData) {
  return newData.get('text', '') == oldData.get('text', '')
    && newData.get('text', '') is string;
}

// Solução: só votes pode aumentar (nunca diminuir)
function isVoteUpdate(newData, oldData) {
  return newData.get('text', '') == oldData.get('text', '')
    && newData.get('monsterId', '') == oldData.get('monsterId', '')
    && newData.get('strategy', '') == oldData.get('strategy', '')
    && newData.votes is number
    && newData.votes == oldData.votes + 1;
}
