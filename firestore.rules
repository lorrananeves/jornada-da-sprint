rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Perfis de Scrum Masters ───────────────────────────────────────────────
    // Apenas o próprio SM (autenticado) pode ler/escrever seu perfil.
    match /smProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Sub-coleção de sessões salvas no perfil do SM
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Sessões de retrospectiva ──────────────────────────────────────────────
    match /sessions/{sessionId} {

      // sessionId deve ser hex de 32 chars (gerado com crypto.getRandomValues)
      allow read: if sessionId.matches('^[0-9a-f]{32}$');

      allow create: if
        sessionId.matches('^[0-9a-f]{32}$')
        && isValidSessionRoot(request.resource.data);

      allow update: if
        sessionId.matches('^[0-9a-f]{32}$')
        && isValidSessionRoot(request.resource.data)
        // smDeviceId e smUid são imutáveis após a criação da sessão:
        // nenhum participante — nem mesmo o SM — pode alterá-los via update.
        && !isChangingIdentityFields(request.resource.data, resource.data)
        // xp só pode crescer e o incremento por operação é limitado ao maior
        // valor de XP do jogo (30 pts — criação de missão). Impede que qualquer
        // cliente grave um valor absoluto arbitrário (ex: xp = 999999).
        && isXpUpdateValid(request.resource.data, resource.data)
        // Campos exclusivos do SM: qualquer alteração exige Auth == smUid.
        // Inclui sprint, team, retroStarted, phaseDurations, phaseStartedAt,
        // currentPhase e completedPhases. Participantes só podem tocar em
        // readySignals, parkingLot, combatMonsterIdx e combatStrategy.
        && (
          !isChangingSmOnlyFields(request.resource.data, resource.data)
          || isScrumMaster(request.resource.data, resource.data)
        )
        // readySignals: cada dispositivo só pode escrever na chave igual ao
        // seu próprio deviceId — impede que um cliente sinalize por outro.
        && isReadySignalsSafe(request.resource.data, resource.data);

      // ── Checkins ─────────────────────────────────────────────────────────
      // O ID do documento é o deviceId do participante (16 hex chars).
      // Um dispositivo só pode criar um único check-in: se o doc já existir,
      // um create falha automaticamente no Firestore (sem necessidade de update).
      //
      // Vínculo obrigatório: itemId == request.resource.data.deviceId.
      // Impede que um cliente crie múltiplos checkins usando IDs hex fabricados.
      // Sem esse vínculo, qualquer cliente poderia chamar setDoc com IDs
      // arbitrários e acumular N respostas, corrompendo "X de Y responderam".
      match /checkins/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && itemId.matches('^[0-9a-f]{16}$')
          && isValidCheckin(request.resource.data)
          && itemId == request.resource.data.deviceId;
        // Checkins são imutáveis após criação
        allow update, delete: if false;
      }

      // ── Tesouros ─────────────────────────────────────────────────────────
      match /treasures/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isValidTreasure(request.resource.data);
        // Só permite atualizar reações — incremento de +1 por escrita (nunca decrementar)
        allow update: if
          validSessionId(sessionId)
          && isReactionUpdate(request.resource.data, resource.data);
        allow delete: if false;

        // Token de reação: {deviceId}_{reaction} como ID — create falha se já existir
        match /reactions/{tokenId} {
          allow read: if validSessionId(sessionId);
          allow create: if
            validSessionId(sessionId)
            && tokenId.matches('^[0-9a-f]{16}_[a-z]+$')
            && request.resource.data.keys().hasOnly(['reactedAt'])
            && request.resource.data.reactedAt is string;
          allow update, delete: if false;
        }
      }

      // ── Monstros ─────────────────────────────────────────────────────────
      match /monsters/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isValidMonster(request.resource.data);
        // Separação explícita SM vs participante:
        //   SM   → text, selected, priorityRank, mergedFrom, merged, mergedInto,
        //           unmerged, discussionResult (+ reactions no merge do keep).
        //   Part → reactions (+1), voteCount (+1).
        // isMonsterUpdateWithRole faz get() da sessão uma única vez e decide o caminho.
        allow update: if
          validSessionId(sessionId)
          && isMonsterUpdateWithRole(sessionId, request.resource.data, resource.data);
        allow delete: if false;

        // Token de reação: {deviceId}_{reaction} como ID — create falha se já existir
        match /reactions/{tokenId} {
          allow read: if validSessionId(sessionId);
          allow create: if
            validSessionId(sessionId)
            && tokenId.matches('^[0-9a-f]{16}_[a-z]+$')
            && request.resource.data.keys().hasOnly(['reactedAt'])
            && request.resource.data.reactedAt is string;
          allow update, delete: if false;
        }
      }

      // ── Notas de discussão ────────────────────────────────────────────────
      // Somente o SM pode criar, editar ou excluir notas.
      // Participantes têm acesso de leitura — a interface não exibe botões,
      // mas a rule é a barreira real contra escritas diretas via API.
      match /discussions/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isSessionScrumMaster(sessionId)
          && isValidDiscussionNote(request.resource.data);
        allow update: if
          validSessionId(sessionId)
          && isSessionScrumMaster(sessionId)
          && isDiscussionNoteUpdate(request.resource.data, resource.data);
        allow delete: if
          validSessionId(sessionId)
          && isSessionScrumMaster(sessionId);
      }

      // ── Votos em monstros ─────────────────────────────────────────────────
      // ID do documento: {deviceId}_{monsterId} — create falha se já existir.
      // Unicidade garante 1 voto por dispositivo por monstro sem transação extra.
      match /monsterVotes/{tokenId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && tokenId.matches('^[0-9a-f]{16}_[0-9a-zA-Z_-]+$')
          && isValidMonsterVote(request.resource.data);
        allow update, delete: if false;
      }

      // ── Soluções ─────────────────────────────────────────────────────────
      match /solutions/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isValidSolution(request.resource.data);
        // Só permite incrementar votos (via transação atomica do castVote)
        allow update: if
          validSessionId(sessionId)
          && isVoteUpdate(request.resource.data, resource.data);
        allow delete: if false;

        // Token de voto: deviceId como ID — create falha se já existir
        match /votes/{deviceId} {
          allow read: if validSessionId(sessionId);
          allow create: if
            validSessionId(sessionId)
            && deviceId.matches('^[0-9a-f]{16}$')
            && request.resource.data.keys().hasOnly(['votedAt'])
            && request.resource.data.votedAt is string;
          allow update, delete: if false;
        }
      }

      // ── Missões ──────────────────────────────────────────────────────────
      match /missions/{itemId} {
        allow read: if validSessionId(sessionId);
        allow create: if
          validSessionId(sessionId)
          && isValidMission(request.resource.data);
        // Permite atualizar apenas o campo status (retomada de missões anteriores)
        allow update: if
          validSessionId(sessionId)
          && isMissionStatusUpdate(request.resource.data, resource.data);
        // Remoção permitida (o SM pode remover missões)
        allow delete: if validSessionId(sessionId);
      }

      // ── Presença (lobby) ─────────────────────────────────────────────────
      match /presence/{deviceId} {
        allow read: if true;
        // delete: permitido (leaveSession melhor esforço)
        allow delete: if deviceId.matches('^[0-9a-f]{16}$');
        // create/update: heartbeat — valida schema com lastSeen + expiresAt
        allow create, update: if
          deviceId.matches('^[0-9a-f]{16}$')
          && request.resource.data.keys().hasOnly(['deviceId', 'lastSeen', 'expiresAt'])
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() == 16
          && request.resource.data.expiresAt is number
          && request.resource.data.expiresAt > request.time.toMillis();
      }

      // ── Indicador de digitação ────────────────────────────────────────────
      match /typing/{deviceId} {
        allow read: if validSessionId(sessionId);
        // Escrita: somente o próprio dispositivo pode gravar/remover o seu doc
        allow create, update: if
          validSessionId(sessionId)
          && deviceId.matches('^[0-9a-f]{16}$')
          && request.resource.data.keys().hasOnly(['phase', 'expiresAt'])
          && request.resource.data.phase is string
          && request.resource.data.phase.size() <= 32
          && request.resource.data.expiresAt is number
          && request.resource.data.expiresAt > request.time.toMillis();
        allow delete: if deviceId.matches('^[0-9a-f]{16}$');
      }
    }

    // Bloqueia qualquer outra coleção não prevista
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── Funções auxiliares ────────────────────────────────────────────────────────

function validSessionId(sessionId) {
  return sessionId.matches('^[0-9a-f]{32}$');
}

function isValidSessionRoot(data) {
  return
    data.keys().hasAll(['currentPhase', 'updatedAt', 'smDeviceId'])
    && data.keys().hasOnly([
      'sprint', 'team', 'currentPhase', 'retroStarted',
      'xp', 'completedPhases', 'createdAt', 'updatedAt', 'smDeviceId',
      'phaseDurations', 'phaseStartedAt', 'smUid',
      // campos sincronizados entre participantes (legado)
      'combatMonsterIdx', 'combatStrategy',
      // foco da discussão — SM controla, participantes seguem em tempo real
      'discussionFocus',
      'readySignals', 'parkingLot'
    ])
    && data.currentPhase is string
    && data.currentPhase.size() <= 32
    && data.updatedAt is string
    && data.smDeviceId is string
    && data.smDeviceId.size() <= 32
    && data.get('xp', 0) is number
    && data.get('xp', 0) >= 0
    && data.get('retroStarted', false) is bool
    && data.get('completedPhases', []).size() <= 20
    && data.get('combatMonsterIdx', 0) is number
    && data.get('combatStrategy', '') is string
    && isValidReadySignals(data.get('readySignals', {}))
    && isValidParkingLot(data.get('parkingLot', []))
    && isValidSprint(data.get('sprint', {}))
    && isValidTeam(data.get('team', {}));
}

// readySignals: { [deviceId: 16 hex]: fase válida } — máximo 200 entradas
// (um por dispositivo participante; 200 é generoso para qualquer equipe real).
function isValidReadySignals(signals) {
  return signals is map
    && signals.size() <= 200;
}

// parkingLot: lista de notas { id, text, createdAt } — máximo 100 itens,
// texto limitado a 500 caracteres cada.
function isValidParkingLot(lot) {
  return lot is list
    && lot.size() <= 100;
}

function isValidSprint(sprint) {
  return sprint is map
    && sprint.keys().hasOnly(['name', 'startDate', 'endDate'])
    && sprint.get('name', '') is string
    && sprint.get('name', '').size() <= 120
    && sprint.get('startDate', '') is string
    && sprint.get('endDate', '') is string;
}

function isValidTeam(team) {
  return team is map
    && team.keys().hasOnly(['name', 'participantCount'])
    && team.get('name', '') is string
    && team.get('name', '').size() <= 120
    && (team.get('participantCount', '') is string || team.get('participantCount', 0) is number);
}

// Campos que somente o SM pode alterar.
//
// Lista completa de campos SM-only:
//   sprint           — nome e datas da Sprint
//   team             — nome da equipe e participantCount
//   retroStarted     — flag que inicia a retro para todos os participantes
//   phaseDurations   — durações registradas de cada fase
//   phaseStartedAt   — timestamps de início de fase
//   currentPhase     — fase atual (avançar retro)
//   completedPhases  — lista de fases já concluídas
//   combatMonsterIdx — foco do combate legado (sincronizado pelo SM para todos)
//   combatStrategy   — estratégia de combate legada (sincronizada pelo SM)
//   discussionFocus  — índice do monstro em foco na discussão (SM → participantes)
//
// parkingLot e readySignals são deliberadamente excluídos: qualquer
// participante precisa escrever neles (notas e sinalização "Terminei").
function isChangingSmOnlyFields(newData, oldData) {
  return
    newData.get('sprint',           null) != oldData.get('sprint',           null)
    || newData.get('team',          null) != oldData.get('team',             null)
    || newData.get('retroStarted',  null) != oldData.get('retroStarted',     null)
    || newData.get('phaseDurations',null) != oldData.get('phaseDurations',   null)
    || newData.get('phaseStartedAt',null) != oldData.get('phaseStartedAt',   null)
    || newData.get('currentPhase',  null) != oldData.get('currentPhase',     null)
    || newData.get('completedPhases',[])  != oldData.get('completedPhases',  [])
    || newData.get('combatMonsterIdx', null) != oldData.get('combatMonsterIdx', null)
    || newData.get('combatStrategy',  null) != oldData.get('combatStrategy',    null)
    || newData.get('discussionFocus', null) != oldData.get('discussionFocus',   null);
}

// readySignals: permite apenas que o dispositivo que está fazendo o request
// escreva na chave correspondente ao seu próprio deviceId.
//
// Regra: nenhuma chave existente pode ser removida ou alterada. Apenas uma
// chave nova pode ser adicionada por write.
//
// Isso impede que um participante:
//   - sinalize "Terminei" em nome de outro dispositivo
//   - apague sinais de outros participantes
//   - faça múltiplas chaves crescerem numa única escrita
//
// Usa MapDiff (sem toList()) para compatibilidade com o emulador Firestore
// em modo standard edition.
function isReadySignalsSafe(newData, oldData) {
  let diff = newData.get('readySignals', {}).diff(oldData.get('readySignals', {}));
  return
    // ── Sem remoções ──────────────────────────────────────────────────────────
    diff.removedKeys().size() == 0

    // ── Sem alterações de valor em chaves existentes ──────────────────────────
    && diff.changedKeys().size() == 0

    // ── No máximo 1 chave nova por write ──────────────────────────────────────
    && diff.addedKeys().size() <= 1;
}

function isChangingIdentityFields(newData, oldData) {
  return
    newData.get('smDeviceId', null) != oldData.get('smDeviceId', null)
    || newData.get('smUid', null) != oldData.get('smUid', null);
}

// Valida alterações no campo xp:
//   1. xp nunca pode diminuir (impede "zerar" ou manipular pontuação).
//   2. O incremento por write é limitado a 30 pts — o maior valor de XP
//      do jogo (criação de missão). Impede escritas absolutas arbitrárias
//      como xp = 999999, que passariam pela validação de tipo (is number && >= 0).
//
// Nota: o frontend legítimo só grava xp via FieldValue.increment em addXP(),
// nunca via setScalarState/saveSession. Esta rule é uma camada de defesa
// extra no servidor para o caso de chamadas diretas à API do Firestore.
function isXpUpdateValid(newData, oldData) {
  let newXp = newData.get('xp', 0);
  let oldXp = oldData.get('xp', 0);
  return newXp >= oldXp && newXp <= oldXp + 30;
}

// Verifica se o request vem do Scrum Master legítimo da sessão.
//
// Dois modos:
//   1. Sessão com conta (smUid != null): verifica Firebase Auth uid.
//      Único modo seguro — prova inequívoca de identidade do SM.
//   2. Sessão sem conta (smUid = null): verifica que smDeviceId não muda.
//      O smDeviceId é imutável após criação (ver isChangingIdentityFields),
//      então o cliente só passa se enviar o mesmo deviceId que está no doc.
//      Aceito como compromisso pragmático: o sessionId de 32 chars hex torna
//      a adivinhação inviável, e o SM sem conta não tem alternativa de auth.
function isScrumMaster(newData, oldData) {
  return oldData.get('smUid', null) != null
    ? (request.auth != null && request.auth.uid == oldData.smUid)
    : (newData.get('smDeviceId', '') == oldData.get('smDeviceId', '')
       && oldData.get('smDeviceId', '').size() > 0);
}

// Verifica se o request vem do Scrum Master a partir de uma subcoleção.
//
// Lê o documento raiz da sessão via get() e delega para isScrumMaster.
// Usada nas subcoleções (ex: discussions) onde o doc pai não está disponível
// diretamente como resource.data.
//
// Nota sobre o modo sem conta: assim como isScrumMaster, aceita o smDeviceId
// presente no header x-sm-device (request.resource.data não tem smDeviceId).
// Como a subcoleção não carrega smDeviceId, o único modo seguro é smUid.
// Para sessões sem smUid, usamos o mesmo padrão de isScrumMaster: o request.auth
// não existe, portanto a verificação cai no ramo do smDeviceId. Contudo, nas
// subcoleções não há como confrontar o smDeviceId do request com o do doc pai
// via request.resource.data — portanto apenas o ramo com smUid é enforcement real.
// Sessões sem smUid ficam protegidas pelo sessionId de 32 hex chars (obscuridade),
// que é o compromisso documentado no restante do código.
function isSessionScrumMaster(sessionId) {
  let session = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
  // Sessão com conta: valida uid. Sem conta: qualquer deviceId não-vazio.
  // Sem ternário para compatibilidade com o emulador Firestore standard edition.
  return (session.get('smUid', null) != null
          && request.auth != null
          && request.auth.uid == session.get('smUid', ''))
      || (session.get('smUid', null) == null
          && session.get('smDeviceId', '').size() > 0);
}

// Avalia update de monstro fazendo get() da sessão uma única vez.
// Necessário porque chamar isSessionScrumMaster duas vezes consumiria
// dois get() — o Firestore permite apenas 1 get() por operação de escrita.
// Sem let/ternário para compatibilidade com o emulador standard edition.
function isMonsterUpdateWithRole(sessionId, newData, oldData) {
  let session = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
  return (
    // Caminho SM: uid autenticado bate com smUid da sessão
    (session.get('smUid', null) != null
     && request.auth != null
     && request.auth.uid == session.get('smUid', '')
     && isSmMonsterUpdate(newData, oldData))
  ) || (
    // Caminho SM sem conta: smUid null, smDeviceId presente
    (session.get('smUid', null) == null
     && session.get('smDeviceId', '').size() > 0
     && isSmMonsterUpdate(newData, oldData))
  ) || (
    // Caminho participante: não é SM
    (session.get('smUid', null) != null
     && (request.auth == null || request.auth.uid != session.get('smUid', ''))
     && isParticipantMonsterUpdate(newData, oldData))
  ) || (
    // Caminho participante sem conta: smUid null — qualquer cliente anônimo
    // (smDeviceId só identifica o SM na sessão sem conta, participantes
    // podem ter qualquer deviceId; a proteção é apenas o sessionId)
    (session.get('smUid', null) == null
     && isParticipantMonsterUpdate(newData, oldData))
  );
}

// ── Validadores de subcoleção ─────────────────────────────────────────────────

function isValidCheckin(data) {
  return data.keys().hasOnly(['score', 'comment', 'deviceId'])
    && data.keys().hasAll(['score', 'deviceId'])
    && data.score is number
    && data.score >= 1 && data.score <= 5
    && data.deviceId is string
    && data.deviceId.size() == 16
    && (data.get('comment', null) == null
        || (data.comment is string && data.comment.size() <= 1000));
}

function isValidTreasure(data) {
  return data.keys().hasOnly(['text', 'category', 'reactions'])
    && data.text is string
    && data.text.size() >= 1 && data.text.size() <= 1000
    && data.category is string
    && data.category in ['treasure', 'recognition', 'learning']
    && data.reactions is map;
}

function isValidMonster(data) {
  return data.keys().hasOnly([
      'text', 'reactions', 'selected', 'priorityRank',
      'mergedFrom', 'merged', 'mergedInto', 'unmerged', 'voteCount',
      'discussionResult'
    ])
    && data.text is string
    && data.text.size() >= 1 && data.text.size() <= 1000
    && data.reactions is map
    && data.selected is bool
    && (data.get('priorityRank', null) == null || data.get('priorityRank', null) is number)
    && (data.get('mergedFrom',   null) == null || data.get('mergedFrom',   []) is list)
    && (data.get('merged',       null) == null || data.get('merged',       false) is bool)
    && (data.get('mergedInto',   null) == null || data.get('mergedInto',   '') is string)
    && (data.get('unmerged',     null) == null || data.get('unmerged',     false) is bool)
    && (data.get('voteCount',    null) == null || data.get('voteCount',    0) is number)
    && isValidDiscussionResult(data.get('discussionResult', null));
}

function isValidSolution(data) {
  return data.keys().hasOnly(['text', 'monsterId', 'strategy', 'votes'])
    && data.text is string
    && data.text.size() >= 1 && data.text.size() <= 1000
    && data.monsterId is string
    && data.strategy is string
    && data.strategy in ['prevent', 'reduce', 'handle']
    && data.votes is number;
}

function isValidMission(data) {
  return data.keys().hasOnly([
      'title', 'description', 'strategy', 'priority', 'owner', 'deadline',
      'monsterId', 'discussionId', 'successCriteria'
    ])
    && data.title is string
    && data.title.size() >= 1 && data.title.size() <= 200
    && data.get('description', '') is string
    && data.get('description', '').size() <= 2000
    && data.get('strategy', '') is string
    && data.get('owner', '') is string
    && data.get('owner', '').size() <= 120
    && data.get('deadline', '') is string
    && data.priority is string
    && data.priority in ['high', 'medium', 'low']
    && (data.get('monsterId', null) == null || data.get('monsterId', '') is string)
    && (data.get('discussionId', null) == null || data.get('discussionId', '') is string)
    && (data.get('successCriteria', null) == null
        || (data.get('successCriteria', '') is string
            && data.get('successCriteria', '').size() <= 1000));
}

// Tesouro: só reações podem mudar (campos text/category imutáveis).
// Cada contador só pode aumentar em +1 por escrita (nunca decrementar, nunca pular).
function isReactionUpdate(newData, oldData) {
  return newData.get('text',     '') == oldData.get('text',     '')
    && newData.get('category', '') == oldData.get('category', '')
    // Cada reação só pode subir +1 ou ficar igual (nunca cair)
    && newData.get('reactions', {}).get('heart',  0) >= oldData.get('reactions', {}).get('heart',  0)
    && newData.get('reactions', {}).get('thumbs', 0) >= oldData.get('reactions', {}).get('thumbs', 0)
    && newData.get('reactions', {}).get('bulb',   0) >= oldData.get('reactions', {}).get('bulb',   0)
    && newData.get('reactions', {}).get('heart',  0) <= oldData.get('reactions', {}).get('heart',  0) + 1
    && newData.get('reactions', {}).get('thumbs', 0) <= oldData.get('reactions', {}).get('thumbs', 0) + 1
    && newData.get('reactions', {}).get('bulb',   0) <= oldData.get('reactions', {}).get('bulb',   0) + 1;
}

// Monstro — atualização pelo Scrum Master.
//
// O SM pode alterar qualquer campo administrativo:
//   rename   → apenas text muda (outros campos imutáveis)
//   select   → apenas selected muda
//   prioritize → apenas priorityRank muda
//   merge keep → text (opt), reactions (soma), selected (OR), mergedFrom crescem
//   merge drop → merged=true + mergedInto=<id>
//   delete   → merged=true + mergedInto='__deleted__'
//   unmerge keep → merged=true, unmerged=true
//   unmerge restore → merged=false, mergedInto=null
//   discussionResult → apenas discussionResult muda
//
// Restrições de schema mantidas para todos os campos.
function isSmMonsterUpdate(newData, oldData) {
  return newData.keys().hasOnly([
      'text', 'reactions', 'selected', 'priorityRank',
      'mergedFrom', 'merged', 'mergedInto', 'unmerged',
      'voteCount', 'discussionResult'
    ])
    && newData.get('text', '') is string
    && newData.get('text', '').size() >= 1
    && newData.get('text', '').size() <= 1000
    && (newData.get('priorityRank', null)  == null || newData.get('priorityRank', null) is number)
    && (newData.get('mergedFrom',   null)  == null || newData.get('mergedFrom',   [])   is list)
    && (newData.get('merged',       null)  == null || newData.get('merged',       false) is bool)
    && (newData.get('mergedInto',   null)  == null || newData.get('mergedInto',   '')   is string)
    && (newData.get('unmerged',     null)  == null || newData.get('unmerged',     false) is bool)
    && (newData.get('voteCount',    null)  == null || newData.get('voteCount',    0)    is number)
    && isValidDiscussionResult(newData.get('discussionResult', null))
    // Reações nunca podem cair (o SM soma reações no merge do keep).
    && newData.get('reactions', {}).get('fire', 0) >= oldData.get('reactions', {}).get('fire', 0)
    && newData.get('reactions', {}).get('eyes', 0) >= oldData.get('reactions', {}).get('eyes', 0)
    && newData.get('reactions', {}).get('bulb', 0) >= oldData.get('reactions', {}).get('bulb', 0);
}

// Monstro — atualização por participante anônimo.
//
// Participantes só podem:
//   1. Reagir (+1 por campo, nunca decrementar, máximo +1 por write).
//      Todos os demais campos devem permanecer inalterados.
//   2. Votar: apenas voteCount sobe +1.
//      Todos os demais campos devem permanecer inalterados.
function isParticipantMonsterUpdate(newData, oldData) {
  return (
    // Reação simples: só reactions muda, +1 em exatamente um campo.
    newData.get('text',      '')    == oldData.get('text',      '')
    && newData.get('selected', false) == oldData.get('selected', false)
    && newData.get('merged',   null)  == oldData.get('merged',   null)
    && newData.get('mergedInto', null)== oldData.get('mergedInto', null)
    && newData.get('mergedFrom', null)== oldData.get('mergedFrom', null)
    && newData.get('unmerged', null)  == oldData.get('unmerged', null)
    && newData.get('priorityRank', null) == oldData.get('priorityRank', null)
    && newData.get('discussionResult', null) == oldData.get('discussionResult', null)
    && newData.get('voteCount', null) == oldData.get('voteCount', null)
    // Reações nunca podem cair
    && newData.get('reactions', {}).get('fire', 0) >= oldData.get('reactions', {}).get('fire', 0)
    && newData.get('reactions', {}).get('eyes', 0) >= oldData.get('reactions', {}).get('eyes', 0)
    && newData.get('reactions', {}).get('bulb', 0) >= oldData.get('reactions', {}).get('bulb', 0)
    // No máximo +1 por campo por write
    && newData.get('reactions', {}).get('fire', 0) <= oldData.get('reactions', {}).get('fire', 0) + 1
    && newData.get('reactions', {}).get('eyes', 0) <= oldData.get('reactions', {}).get('eyes', 0) + 1
    && newData.get('reactions', {}).get('bulb', 0) <= oldData.get('reactions', {}).get('bulb', 0) + 1
  ) || (
    // voteCount: apenas voteCount sobe +1.
    'voteCount' in newData.diff(oldData).affectedKeys()
    && newData.diff(oldData).affectedKeys().hasOnly(['voteCount'])
    && newData.get('voteCount', 0) == oldData.get('voteCount', 0) + 1
    && newData.get('text',      '')    == oldData.get('text',      '')
    && newData.get('selected',  false) == oldData.get('selected',  false)
    && newData.get('reactions', {})    == oldData.get('reactions', {})
    && newData.get('discussionResult', null) == oldData.get('discussionResult', null)
  );
}

// Solução: só votes pode aumentar (nunca diminuir)
function isVoteUpdate(newData, oldData) {
  return newData.get('text', '') == oldData.get('text', '')
    && newData.get('monsterId', '') == oldData.get('monsterId', '')
    && newData.get('strategy', '') == oldData.get('strategy', '')
    && newData.votes is number
    && newData.votes == oldData.votes + 1;
}

// Nota de discussão: todos os campos podem ser criados com os valores iniciais.
function isValidDiscussionNote(data) {
  return data.keys().hasOnly(['monsterId', 'type', 'text', 'createdAt', 'updatedAt'])
    && data.keys().hasAll(['monsterId', 'type', 'text', 'createdAt'])
    && data.monsterId is string
    && data.monsterId.size() >= 1 && data.monsterId.size() <= 64
    && data.type is string
    && data.type in ['insight', 'mitigation', 'agreement', 'action', 'observation']
    && data.text is string
    && data.text.size() >= 1 && data.text.size() <= 1000
    && data.createdAt is string
    && (data.get('updatedAt', null) == null || data.updatedAt is string);
}

// Nota de discussão: permite editar type e text; monsterId e createdAt imutáveis.
function isDiscussionNoteUpdate(newData, oldData) {
  return newData.get('monsterId', '') == oldData.get('monsterId', '')
    && newData.get('createdAt', '')   == oldData.get('createdAt', '')
    && newData.get('type', '') is string
    && newData.get('type', '') in ['insight', 'mitigation', 'agreement', 'action', 'observation']
    && newData.get('text', '') is string
    && newData.get('text', '').size() >= 1
    && newData.get('text', '').size() <= 1000
    && newData.get('updatedAt', '') is string;
}

// Voto em monstro: { deviceId, monsterId, votedAt } — imutável após criação.
function isValidMonsterVote(data) {
  return data.keys().hasOnly(['deviceId', 'monsterId', 'votedAt'])
    && data.keys().hasAll(['deviceId', 'monsterId', 'votedAt'])
    && data.deviceId is string && data.deviceId.size() == 16
    && data.monsterId is string && data.monsterId.size() >= 1
    && data.votedAt is string;
}

// Missão: permite apenas atualizar o campo status (retomada de missões anteriores)
function isMissionStatusUpdate(newData, oldData) {
  // Todos os campos imutáveis devem ser preservados
  return newData.get('title', '')           == oldData.get('title', '')
    && newData.get('description', '')     == oldData.get('description', '')
    && newData.get('strategy', '')        == oldData.get('strategy', '')
    && newData.get('priority', '')        == oldData.get('priority', '')
    && newData.get('owner', '')           == oldData.get('owner', '')
    && newData.get('deadline', '')        == oldData.get('deadline', '')
    && newData.get('monsterId', '')       == oldData.get('monsterId', '')
    && newData.get('discussionId', '')    == oldData.get('discussionId', '')
    && newData.get('successCriteria', '') == oldData.get('successCriteria', '')
    // status é o único campo que pode mudar
    && newData.get('status', '') is string
    && newData.get('status', '') in ['done', 'partial', 'pending', ''];
}

// discussionResult: valor nulo ou um dos cinco resultados possíveis.
function isValidDiscussionResult(result) {
  return result == null
    || result in ['mitigation', 'agreement', 'action', 'insight', 'observation'];
}

