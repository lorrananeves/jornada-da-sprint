    "eslint-plugin-vitest": "^0.5.4",
    "firebase-tools": "^15.28.1",
    "jsdom": "^30.0.1",
    "vite": "^5.0.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
